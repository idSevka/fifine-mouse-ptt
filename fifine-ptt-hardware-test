#!/usr/bin/env python3
"""Live hardware test: measures what the button actually sends.

Unlike fifine-ptt-selftest, which tests LOGIC using simulated events and cannot
fail due to an issue below the code, this script checks only the hardware:

  * how many events arrive for one physical press;
  * whether the hold lasts as long as you hold the button;
  * whether there are auto-repeats, bounce, or firmware double-triggers.

This catches problems simulation cannot: a mouse macro that turns one press
into a press/release pair; a bouncing button; firmware sending auto-repeats.
On such devices, ANY "press → hold → release" scheme breaks down, and no logic
change can help.

    fifine-ptt-hardware-test              # test the mouse side button
    fifine-ptt-hardware-test --device X   # test another device by name

Run the script and follow the prompts. Exit code: 0 = clean, 1 = problems found.
"""

from __future__ import annotations

import argparse
import os
import select
import struct
import sys
import time

EV_KEY = 1
EV_SIZE = struct.calcsize("llHHi")

# Thresholds used to assess button health.
MIN_HOLD = 0.8          # shorter means it was not a hold
DEBOUNCE_WINDOW = 0.05  # events closer than this are considered bounce
AUTOREPEAT_WINDOW = 0.15  # repeated presses at this interval are auto-repeat


def dev_name(node: str) -> str:
    entry = os.path.basename(node)
    try:
        return open(f"/sys/class/input/{entry}/device/name").read().strip()
    except OSError:
        return "?"


def _key_bit_set(caps: str, code: int) -> bool:
    words = caps.split()
    index, offset = divmod(code, 64)
    if index >= len(words):
        return False
    return bool(int(words[len(words) - 1 - index], 16) >> offset & 1)


def find_devices(match: str) -> list[str]:
    nodes = []
    base = "/dev/input"
    if not os.path.isdir(base):
        return nodes
    for entry in sorted(os.listdir(base)):
        if not entry.startswith("event"):
            continue
        try:
            name = open(f"/sys/class/input/{entry}/device/name").read().strip()
            caps = open(f"/sys/class/input/{entry}/device/capabilities/key").read()
        except OSError:
            continue
        # Mouse button device: check BTN_LEFT, which every mouse has.
        if match.lower() in name.lower() and _key_bit_set(caps, 272):
            nodes.append(f"{base}/{entry}")
    return nodes


class Press:
    """One physical press: events collected within an interval."""

    def __init__(self, code: int, down_at: float) -> None:
        self.code = code
        self.down_at = down_at
        self.up_at: float | None = None
        self.extra_downs: list[float] = []
        self.extra_ups: list[float] = []

    @property
    def duration(self) -> float | None:
        return None if self.up_at is None else self.up_at - self.down_at

    @property
    def closed(self) -> bool:
        return self.up_at is not None


def capture(nodes: list[str], seconds: int, code_filter: int | None
            ) -> tuple[list[Press], dict[str, int]]:
    """Collect presses for the given duration. Returns (presses, event counts)."""
    fds: dict[int, str] = {}
    for node in nodes:
        try:
            fds[os.open(node, os.O_RDONLY | os.O_NONBLOCK)] = node
        except OSError as err:
            print(f"  ! cannot open {node}: {err}", file=sys.stderr)

    raw_counter: dict[str, int] = {}
    presses: list[Press] = []
    current: Press | None = None
    deadline = time.time() + seconds

    try:
        while time.time() < deadline:
            ready, _, _ = select.select(list(fds), [], [], 0.2)
            for fd in ready:
                try:
                    data = os.read(fd, 4096)
                except OSError:
                    continue
                for off in range(0, len(data) - EV_SIZE + 1, EV_SIZE):
                    chunk = data[off:off + EV_SIZE]
                    if len(chunk) < EV_SIZE:
                        break
                    _, _, etype, code, value = struct.unpack("llHHi", chunk)
                    if etype != EV_KEY:
                        continue
                    label = f"{dev_name(fds[fd])}::code{code}"
                    raw_counter[label] = raw_counter.get(label, 0) + 1
                    if code_filter is not None and code != code_filter:
                        continue
                    now = time.time()
                    if value == 1:
                        if current is None or current.closed:
                            current = Press(code, now)
                            presses.append(current)
                        else:
                            # A press while the button is already down is auto-repeat.
                            current.extra_downs.append(now)
                    elif value == 0 and current is not None and not current.closed:
                        current.up_at = now
                    elif value == 0 and current is not None and current.closed:
                        current.extra_ups.append(now)
    finally:
        for fd in fds:
            os.close(fd)
    return presses, raw_counter


def analyse(presses: list[Press]) -> tuple[list[str], list[str]]:
    """Return (problems, notes)."""
    problems: list[str] = []
    notes: list[str] = []

    if not presses:
        problems.append("No presses were detected.")
        return problems, notes

    for i, p in enumerate(presses, 1):
        dur = p.duration
        extra = len(p.extra_downs)

        if dur is None:
            problems.append(
                f"Press {i}: received a press, but NO release arrived. "
                f"The release was lost, so hold logic cannot restore the state.")
            continue

        if dur < DEBOUNCE_WINDOW:
            problems.append(
                f"Press {i}: press and release arrived after {dur*1000:.1f} ms — "
                f"this is bounce or a firmware macro, not a hold.")

        if extra:
            notes.append(
                f"Press {i}: {extra} extra presses during the hold "
                f"(auto-repeat). The daemon ignores them using a flag, but it is useful to know.")

        if dur >= MIN_HOLD:
            notes.append(f"Press {i}: {dur:.2f} s hold — good.")
        elif dur >= DEBOUNCE_WINDOW:
            notes.append(f"Press {i}: short press of {dur:.3f} s (not a hold).")

    return problems, notes


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--device", default="",
                        help="substring of the device name (defaults to any mouse)")
    parser.add_argument("--seconds", type=int, default=0,
                        help="shorten each step to N seconds (defaults to 10/12/15)")
    parser.add_argument("--code", type=int, default=None,
                        help="filter for this button code only")
    args = parser.parse_args()

    print("=== Live hardware test ===")
    print()

    nodes = find_devices(args.device)
    if not nodes:
        print(f"No mouse button devices found"
              f"{' matching ' + repr(args.device) if args.device else ''}.")
        print()
        print("To see all devices and their codes:")
        print("    python3 scripts/mouse-hid-sniff.py 20")
        return 1

    print("Listening to:")
    for n in nodes:
        print(f"    {n}  {dev_name(n)}")
    if not args.code:
        print()
        print("Tip: specify --code <N> to see only one button.")
    print()
    steps = [
        ("1/3  Press the side button ONCE, quickly (a click).", 10),
        ("2/3  Press and HOLD for 2 seconds, then release.", 12),
        ("3/3  Press and hold for 3 seconds; watch the time without releasing, then release.", 15),
    ]
    if args.seconds:
        steps = [(text, args.seconds) for text, _ in steps]

    total = sum(d for _, d in steps)
    print(f"You will now be asked to perform three actions. {total} seconds total.")

    all_presses: list[Press] = []
    counters: dict[str, int] = {}
    for text, dur in steps:
        print(f"--- {text}  (listening for {dur} s)")
        sys.stdout.flush()
        presses, counter = capture(nodes, dur, args.code)
        all_presses.extend(presses)
        for k, v in counter.items():
            counters[k] = counters.get(k, 0) + v
        if presses:
            for p in presses:
                d = f"{p.duration:.3f} s" if p.duration is not None else "NO RELEASE"
                print(f"      detected: code={p.code}, duration {d}, "
                      f"extra presses={len(p.extra_downs)}")
        else:
            print("      nothing detected")
        print()

    print("=== Results ===")
    problems, notes = analyse(all_presses)

    for n in notes:
        print(f"  [ok]   {n}")
    for p in problems:
        print(f"  [FAIL] {p}")

    print()
    print("=== All events during the test (by device and code) ===")
    for k in sorted(counters):
        print(f"  {counters[k]:4}  {k}")
    seen = {f"code{p.code}" for p in all_presses}
    if args.code is None and len(seen) > 1:
        print()
        print(f"  Codes observed: {', '.join(sorted(seen))} — if you pressed one")
        print(f"  button but saw several codes, the device sends a composite event.")
        print(f"  Select the desired code with --code <N>.")

    print()
    if problems:
        print(f"SUMMARY: {len(problems)} problem(s) found. See [FAIL] above.")
        print("If press and release arrive as an immediate pair, the cause is firmware or")
        print("a mouse macro: hold logic will not work on this device.")
        return 1

    print("SUMMARY: the hardware sends valid events; hold logic can be used.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print()
        print("Interrupted.")
        sys.exit(130)
