[Unit]
Description=Push-to-talk / push-to-mute for a USB microphone via mouse side button
Documentation=https://github.com/idSevka/fifine-mouse-ptt
# The daemon controls the microphone through pactl, so the audio server must be
# ready. Wants instead of Requires: the unit will survive a PipeWire restart.
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/.local/bin/fifine-ptt
# FIFINE_TOUCH=1 enables synchronization with the button on the microphone body.
# Remove this if you only want the mouse side button.
Environment=FIFINE_TOUCH=1
# Do NOT add SupplementaryGroups=input here: systemd user units cannot change
# groups (fails with "Changing group credentials failed: Operation not permitted",
# status=216/GROUP). The user must belong to the input group — run
# sudo usermod -aG input $USER, then log in again. The group is then inherited
# by all of the user's processes, including this service.
#
# Check with: id -nG | tr ' ' '\n' | grep -x input
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
