#!/usr/bin/env python3
"""Push-to-talk / push-to-mute for a Fifine microphone using a mouse side button.

Logic (the correct approach for a hold button):

    press   -> save the CURRENT microphone state and toggle it
    release -> restore exactly the saved state

Unlike the previous Bash version, state lives in a different place and events
come from a different source:

  * state is kept in process memory, not a file, so an extra press cannot
    overwrite it and a missed release cannot lose it;
  * events are read directly from evdev (BTN_EXTRA, code 276), not through a
    Hyprland binding. While a button is held, Hyprland sends repeated presses
    at varying intervals (some receivers produce 0.2 / 0.4 / 1.8 s), and the
    old script's 400 ms time guard mistook them for new presses — hence “only
    works in one position”;
  * repeated BTN_EXTRA=1 events while the button is already held are ignored
    using a flag, without timers or heuristics: the state is left untouched
    until value=0 is received.

No state files or timers — only the pressed flag.
"""

from __future__ import annotations

import argparse
import fcntl
import os
import select
import struct
import subprocess
import sys
import time


# --------------------------------------------------------------- load env
def _load_config() -> None:
    """Load ~/.config/fifine-ptt/env into the environment without overwriting existing values.

    This helps portability: device names and the audio source vary on other
    machines. Instead of editing the code, run fifine-setup.py once to write
    this file. Variables set manually in the environment take precedence, so
    the configuration can be overridden for one run without editing anything.
    """
    path = os.path.expanduser("~/.config/fifine-ptt/env")
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                key, value = key.strip(), value.strip().strip("'\"")
                os.environ.setdefault(key, value)
    except OSError:
        pass          # No config file; use the defaults.


_load_config()


SOURCE = os.environ.get(
    "FIFINE_SOURCE",
    "alsa_input.usb-fifine_Microphones_fifine_Microphone_REV1.0-00.analog-stereo",
)
# Find the device by name rather than event-node number: numbers change when
# the mouse is reconnected, but names do not.
DEVICE_MATCH = os.environ.get("FIFINE_DEVICE_MATCH", "Beken USB Gaming Mouse")

# BTN_EXTRA is sent by this mouse's side button (verified with evdev capture:
# BTN_EXTRA=1 / BTN_EXTRA=0, with no hardware-level autorepeats).
BINDINGS = {
    int(os.environ.get("FIFINE_BTN", "276")): "hold",
}

# Touch button on the microphone body: fifine Consumer Control, event7, code
# 256. It is a separate device with a separate code, so it has its own handler.
TOUCH_BUTTON = int(os.environ.get("FIFINE_TOUCH_BTN", "256"))
TOUCH_DEVICE_MATCH = os.environ.get("FIFINE_TOUCH_DEVICE_MATCH", "fifine")

# Touch-button handling is DISABLED by default. The touch button toggles the
# gate inside the chip, while pactl toggles `Mic Capture Switch`; these are
# distinct gates (measured). Toggling the system gate on a touch press may
# synchronize them or may toggle twice. Until confirmed in a live Discord
# session, the default behavior remains unchanged; enable it explicitly:
#   FIFINE_TOUCH=1 fifine-ptt
TOUCH_BUTTON_ENABLED = bool(os.environ.get("FIFINE_TOUCH"))

EV_KEY = 1
EV_SIZE = struct.calcsize("llHHi")

debug_enabled = bool(os.environ.get("FIFINE_DEBUG"))


def log(message: str) -> None:
    if debug_enabled:
        print(f"{time.strftime('%H:%M:%S')} {message}", file=sys.stderr, flush=True)


# ------------------------------------------------------------------ pactl layer
def _pactl(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["pactl", *args], capture_output=True, text=True)


def source_available() -> bool:
    """Check whether the source exists in the audio server.

    Without this check, an incorrect source name causes the worst-case
    scenario: is_muted() returns False (the output has no "Mute: yes"), the
    daemon assumes the microphone is unmuted, and set_muted() silently fails
    with a nonzero exit code. From the outside, this looks like “the button
    does nothing,” with no explanation. This is the first issue likely to be
    encountered on another machine.

    The `pactl list sources short` format is index<TAB>name<TAB>driver..., so
    the NAME IS IN THE SECOND FIELD. The first field is a numeric index, and
    checking it always returns False.
    """
    out = _pactl("list", "sources", "short")
    if out.returncode != 0:
        return False
    for line in out.stdout.splitlines():
        fields = line.split("\t")
        if len(fields) >= 2 and fields[1] == SOURCE:
            return True
    return False


def is_muted() -> bool:
    """Read the actual state from PipeWire rather than from local memory."""
    out = _pactl("get-source-mute", SOURCE)
    return "Mute: yes" in out.stdout


def set_muted(muted: bool) -> None:
    _pactl("set-source-mute", SOURCE, "1" if muted else "0")


def notify(text: str, icon: str) -> None:
    """OSD notification. DISABLED intentionally.

    This used to call omarchy-osd, which caused confusion: the user checked the
    microphone state using this text instead of the device itself, and the
    notification was interpreted as “the button behavior changed.” The OSD
    displays what the script decided, not what actually happened in the
    hardware — an extra layer that hinders diagnosis.

    Re-enable with: export FIFINE_OSD=1
    """
    if not os.environ.get("FIFINE_OSD"):
        return
    try:
        subprocess.Popen(
            ["omarchy-osd", "-i", icon, "-m", text],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        pass


# ------------------------------------------------------------------- evdev layer
def find_event_nodes(match: str) -> list[str]:
    """Return all /dev/input/eventN nodes whose capabilities include BTN_EXTRA
    and whose name contains match (case-insensitive)."""
    nodes = []
    for name in sorted(os.listdir("/dev/input")):
        if not name.startswith("event"):
            continue
        node = f"/dev/input/{name}"
        try:
            dev_name = open(f"/sys/class/input/{name}/device/name").read().strip()
        except OSError:
            continue
        if match.lower() not in dev_name.lower():
            continue
        try:
            caps = open(f"/sys/class/input/{name}/device/capabilities/key").read()
        except OSError:
            continue
        if not _key_bit_set(caps, 276):
            continue
        nodes.append(node)
    return nodes


def find_touch_nodes() -> list[str]:
    """Find microphone touch-button devices by name and code 256.

    This is a DIFFERENT physical device — the microphone's own Consumer
    Control, not the mouse. Code 256 (BTN_0 / KEY_BUTTONCONFIG) is the only
    non-media code in its mask, so it uniquely identifies the touch button.
    """
    nodes = []
    for name in sorted(os.listdir("/dev/input")):
        if not name.startswith("event"):
            continue
        node = f"/dev/input/{name}"
        try:
            dev_name = open(f"/sys/class/input/{name}/device/name").read().strip()
            caps = open(f"/sys/class/input/{name}/device/capabilities/key").read()
        except OSError:
            continue
        if (TOUCH_DEVICE_MATCH.lower() in dev_name.lower()
                and _key_bit_set(caps, TOUCH_BUTTON)):
            nodes.append(node)
    return nodes


def _key_bit_set(caps: str, code: int) -> bool:
    """Check a bit in capabilities/key (a set of 64-bit little-endian words)."""
    words = caps.split()
    index, offset = divmod(code, 64)
    if index >= len(words):
        return False
    word = int(words[len(words) - 1 - index], 16)
    return bool(word >> offset & 1)


def open_nodes(nodes: list[str]) -> dict[int, str]:
    fds = {}
    for node in nodes:
        try:
            fds[os.open(node, os.O_RDONLY | os.O_NONBLOCK)] = node
        except OSError as err:
            log(f"cannot open {node}: {err}")
    return fds


def sync_nodes(fds: dict[int, str], nodes: list[str]) -> list[str]:
    """Close missing nodes and open new ones after USB hotplug."""
    wanted = set(nodes)
    removed = []
    for fd, node in list(fds.items()):
        if node not in wanted:
            fds.pop(fd)
            try:
                os.close(fd)
            except OSError:
                pass
            removed.append(node)
            log(f"device disconnected: {node}")
    current = set(fds.values())
    for node in nodes:
        if node not in current:
            opened = open_nodes([node])
            fds.update(opened)
            if opened:
                log(f"device connected: {node}")
    return removed


def drop_fd(fds: dict[int, str], fd: int) -> None:
    node = fds.pop(fd, None)
    if node is not None:
        try:
            os.close(fd)
        except OSError:
            pass
        log(f"device lost: {node}")


# ------------------------------------------------------------------- main
class HoldMic:
    def __init__(self) -> None:
        self.pressed = False          # Button is physically held (debounce repeated presses).
        self.saved_muted: bool | None = None   # State to restore on release.

    def on_press(self) -> None:
        if self.pressed:
            # Repeated press while the button is already held. Hyprland sends
            # these, evdev on this mouse does not; silently ignore either case.
            log("press (repeat; state unchanged)")
            return
        self.pressed = True
        self.saved_muted = is_muted()
        set_muted(not self.saved_muted)
        now_muted = not self.saved_muted
        log(f"press: was {'muted' if self.saved_muted else 'unmuted'} "
            f"-> now {'muted' if now_muted else 'unmuted'}")
        # Show one notification on PRESS with the state AFTER toggling.
        # Show nothing on release: holding is one user action, and two
        # notifications for it look like two separate events.
        notify("Microphone muted" if now_muted else "Microphone unmuted",
               "microphone-muted" if now_muted else "microphone")

    def on_release(self) -> None:
        if not self.pressed or self.saved_muted is None:
            log("release without press — ignoring")
            return
        self.pressed = False
        restore = self.saved_muted
        self.saved_muted = None
        set_muted(restore)
        log(f"release: restored {'muted' if restore else 'unmuted'}")
        # No notification: the state was already shown on press, and holding
        # is one user action. A second notification looks like a second event
        # and causes confusion (“why does it say unmuted on release?”).

    def on_device_lost(self) -> None:
        """Restore the original mute state if the USB mouse disconnects while held."""
        if self.pressed and self.saved_muted is not None:
            restore = self.saved_muted
            self.pressed = False
            self.saved_muted = None
            set_muted(restore)
            log("mouse disconnected: restored the original microphone state")

    def on_touch_button(self) -> None:
        """Touch button on the microphone body (event7, code 256).

        Why this is here: the microphone has TWO independent mute gates:

          * The gate inside the chip is controlled by the touch button and
            indicated by the light on the body. It is NOT reported to the
            system: frame-by-frame polling with pactl and amixer during six
            consecutive presses confirmed that `Mic Capture Switch` never
            changed.
          * `Mic Capture Switch` in ALSA/PipeWire is controlled by pactl, and
            Discord/the browser uses it to determine whether audio is heard.

        The light reflects BOTH gates; the system reflects only the second.
        After a touch-button press, the light and system can therefore disagree,
        and the daemon, reading state through pactl, made decisions based on a
        state DIFFERENT from the one shown by the indicator. This caused the
        “only works in one position” symptom.

        This handler keeps them in sync: when the touch button is pressed, the
        physical gate toggles, so we also toggle the system gate.

        Enable with FIFINE_TOUCH=1 (DISABLED by default: the behavior of the
        two gates has not been fully verified; see --status).
        """
        if not TOUCH_BUTTON_ENABLED:
            return
        if self.pressed:
            # Touch button pressed while the mouse button is held: the original
            # state is already saved, so toggling it would make release restore
            # the wrong state.
            log("touch button pressed while held — ignoring")
            return
        before = is_muted()
        set_muted(not before)
        now_muted = not before
        log(f"touch button: was {'muted' if before else 'unmuted'} "
            f"-> now {'muted' if now_muted else 'unmuted'}")
        # Show one notification per press, just like the mouse button.
        notify("Microphone muted" if now_muted else "Microphone unmuted",
               "microphone-muted" if now_muted else "microphone")


def run_daemon() -> int:
    mic = HoldMic()

    # Check the audio server BEFORE entering the loop; otherwise a wrong source
    # makes the button appear to do nothing, without any explanation.
    if not source_available():
        print(f"Source '{SOURCE}' was not found in the audio server.\n"
              f"List available sources with:\n"
              f"    pactl list sources short\n"
              f"and set a custom source with:\n"
              f"    FIFINE_SOURCE=<name> fifine-ptt",
              file=sys.stderr)
        return 1

    # Devices are rescanned because eventN changes after USB hotplug.
    fds = open_nodes(find_event_nodes(DEVICE_MATCH))
    touch_fds: dict[int, str] = {}
    if TOUCH_BUTTON_ENABLED:
        touch_fds = open_nodes(find_touch_nodes())
        if not touch_fds:
            log("touch button is enabled, but the microphone device was not found")

    watch = {**fds, **touch_fds}
    for node in watch.values():
        log(f"listening to {node}")
    if not fds:
        log("mouse not found yet; waiting for it to connect")
    scan_interval = 1.0
    last_scan = 0.0

    try:
        while True:
            now = time.monotonic()
            if now - last_scan >= scan_interval:
                removed = sync_nodes(fds, find_event_nodes(DEVICE_MATCH))
                sync_nodes(touch_fds,
                           find_touch_nodes() if TOUCH_BUTTON_ENABLED else [])
                if removed:
                    mic.on_device_lost()
                watch = {**fds, **touch_fds}
                last_scan = now

            try:
                ready, _, _ = select.select(list(watch), [], [], scan_interval)
            except (OSError, ValueError) as err:
                log(f"select error: {err}; rescanning devices")
                for fd in list(fds):
                    drop_fd(fds, fd)
                for fd in list(touch_fds):
                    drop_fd(touch_fds, fd)
                if mic.pressed:
                    mic.on_device_lost()
                watch = {}
                last_scan = 0.0
                continue

            for fd in ready:
                source_fds = touch_fds if fd in touch_fds else fds
                try:
                    data = os.read(fd, 4096)
                except OSError as err:
                    log(f"read error for {source_fds.get(fd, fd)}: {err}")
                    drop_fd(source_fds, fd)
                    if source_fds is fds:
                        mic.on_device_lost()
                    last_scan = 0.0
                    continue
                if not data:
                    drop_fd(source_fds, fd)
                    if source_fds is fds:
                        mic.on_device_lost()
                    last_scan = 0.0
                    continue
                is_touch = fd in touch_fds
                for offset in range(0, len(data) - EV_SIZE + 1, EV_SIZE):
                    _, _, etype, code, value = struct.unpack(
                        "llHHi", data[offset:offset + EV_SIZE])
                    if etype != EV_KEY:
                        continue

                    if is_touch:
                        # Touch button: handle the press edge.
                        if code == TOUCH_BUTTON and value == 1:
                            mic.on_touch_button()
                        continue

                    if code not in BINDINGS:
                        continue
                    if value == 1:
                        mic.on_press()
                    elif value == 0:
                        mic.on_release()
                    # value == 2 is a kernel-level autorepeat; intentionally ignore it.
    except KeyboardInterrupt:
        # If the daemon is stopped while the button is held, restore the
        # original state; otherwise the microphone will remain toggled.
        if mic.pressed and mic.saved_muted is not None:
            set_muted(mic.saved_muted)
            log("stopped: restored the original state")
        return 0
    finally:
        for fd in {**fds, **touch_fds}:
            try:
                os.close(fd)
            except OSError:
                pass


def acquire_singleton_lock() -> "IO[str] | None":
    """Acquire an exclusive lock to prevent a second daemon instance from starting.

    Return the open lock file (keep it open until the process exits), or None
    if another instance is already running.

    Why: the daemon previously had two independent autostart mechanisms
    (systemd --user and ~/.config/autostart). Accidentally restoring the second
    one resulted in two processes reading the same mouse button. Both saw the
    press and toggled the microphone; on release both restored the state, so it
    returned to its original value and appeared as if “the button did nothing.”

    flock (rather than a PID file) is intentional: the kernel releases the lock
    when the process exits, so even a daemon killed with `kill -9` does not
    leave a stale lock that would prevent the next launch.
    """
    path = os.path.expanduser("~/.run/fifine-ptt.lock")
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        lock = open(path, "w")
    except OSError:
        return None          # Cannot create the file; proceed without the lock.

    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        return False         # The lock is held by another running instance.

    lock.write(f"{os.getpid()}\n")
    lock.flush()
    return lock


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--status", action="store_true",
                        help="show the microphone state and exit")
    parser.add_argument("--once", action="store_true",
                        help="run one read cycle instead of the daemon (for tests)")
    args = parser.parse_args()

    if args.status:
        print(f"{SOURCE}: {'muted' if is_muted() else 'unmuted'}")
        print(f"mouse:      {find_event_nodes(DEVICE_MATCH) or 'not found'}")
        print(f"touch:      {find_touch_nodes() or 'not found'}"
              f"  (handling: {'ON' if TOUCH_BUTTON_ENABLED else 'off'})")
        return 0

    # --status only reads the state and exits; it does not need the lock.
    lock = acquire_singleton_lock()
    if lock is False:
        # Always print this directly rather than through log(): log() is silent
        # without FIFINE_DEBUG, but this exit must always be visible. Otherwise,
        # the second instance disappears silently, leaving no clue in the
        # systemd journal about why the daemon stopped working after a second
        # autostart entry was added.
        print("fifine-ptt is already running in another instance; exiting "
              "(duplicate autostart protection)", file=sys.stderr, flush=True)
        return 0

    return run_daemon()


if __name__ == "__main__":
    sys.exit(main())
