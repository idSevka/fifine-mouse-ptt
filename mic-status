#!/usr/bin/env bash
# Shows the ACTUAL microphone state at two levels:
# PipeWire and the hardware capture switch in the USB chip.
#
# Why: labels and pop-ups show what the program decided,
# not what happened on the hardware. To check button behavior, rely
# only on this output.
#
#   mic-status          # check once
#   watch -n0.3 mic-status    # monitor in real time while pressing the button
set -u

# Source: either explicitly specified or taken from the PipeWire default.
SOURCE="${FIFINE_SOURCE:-$(pactl get-default-source 2>/dev/null || true)}"
if [ -z "${SOURCE:-}" ]; then
  echo "Could not determine the source. Set FIFINE_SOURCE=..." >&2
  exit 1
fi

# ALSA card and capture control name: determine from the source, without hardcoding.
# For a source like alsa_input.usb-<card>..., find the card with the matching card/name.
card=""
if [ -n "${FIFINE_ALSA_CARD:-}" ]; then
  card="$FIFINE_ALSA_CARD"
else
  # PipeWire itself provides api.alsa.card — more reliable than parsing the name.
  card=$(pactl list sources 2>/dev/null | awk -v s="$SOURCE" '
    $0 ~ "Name: "s {found=1}
    found && /api\.alsa\.card = / {gsub(/[^0-9]/,"",$3); print $3; exit}
  ')
fi

pipewire_state=$(pactl get-source-mute "$SOURCE" 2>/dev/null | awk '{print $2}')

# The only capture control with a switch is usually named 'Mic' or 'Capture'.
alsa_state=""
if [ -n "${card:-}" ]; then
  for ctl in Mic Capture; do
    out=$(amixer -c "$card" sget "$ctl" 2>/dev/null) || continue
    # Take the last [on]/[off] value — this is the capture channel state.
    alsa_state=$(printf '%s' "$out" | grep -o '\[\(on\|off\)\]' | tail -1 | tr -d '[]')
    [ -n "$alsa_state" ] && break
  done
fi

human() {
  case "$1" in
    yes|off) echo "DISABLED (muted)" ;;
    no|on)   echo "ENABLED (live)" ;;
    *)       echo "unknown" ;;
  esac
}

printf '%-14s %-12s %s\n' "$(date +%H:%M:%S)" "PipeWire:" "$(human "${pipewire_state:-?}")   [${pipewire_state:-?}]"
if [ -n "${alsa_state:-}" ]; then
  printf '%-14s %-12s %s\n' "" "ALSA (chip):" "$(human "$alsa_state")   [$alsa_state]  (card $card)"
else
  printf '%-14s %-12s %s\n' "" "ALSA (chip):" "unreadable (card ${card:-undefined})"
fi

if [ -n "${pipewire_state:-}" ] && [ -n "${alsa_state:-}" ]; then
  expected_alsa=$([ "$pipewire_state" = "yes" ] && echo off || echo on)
  if [ "$alsa_state" != "$expected_alsa" ]; then
    echo "!! MISMATCH: PipeWire and the chip show different states — this is the bug,"
    echo "   not the button logic. Report this output."
  fi
fi
